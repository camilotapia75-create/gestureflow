# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
#
# Steps:
#   1. Create a free Supabase project at https://supabase.com
#   2. Go to Project Settings → API
#   3. Copy "Project URL" and "anon / public" key below
#   4. Go to SQL Editor and paste + run the contents of supabase/schema.sql
#   5. (Optional) Enable Google OAuth in Authentication → Providers
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase service role (server-only — never expose to browser) ─────────────
# Get from: https://app.supabase.com/project/<your-project>/settings/api → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Web Push / VAPID ─────────────────────────────────────────────────────────
# Generate a fresh pair with:  node scripts/generate-vapid.mjs
# Add both to Vercel Environment Variables (Settings → Environment Variables).
# NEXT_PUBLIC_ key is safe to expose; VAPID_PRIVATE_KEY must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BCdmOnfzKWTsQpHasCvnx-25VSLPGtX0m2v8QQ1ezWJobKy3KIb5lS6Cuc8Ri_vgUQDrazT36Xh1m8fn7R9hMWM
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_EMAIL=admin@gestureflow.app

# ── Vercel Cron secret (optional but recommended) ────────────────────────────
# Set the same random string in Vercel env vars to protect /api/push/send.
CRON_SECRET=your-random-secret-here
